            "python": "${command:python.interpreterPath}",
            "env": {
                "CUDA_VISIBLE_DEVICES": "7"
            }
        },
        {
            "name": "lmms: extract_gdt",
            "type": "debugpy",
            "request": "launch",
            "program": "../lmms-eval/lmms_eval",
            //"module": "lmms-eval.lmms_eval",
            "console": "internalConsole",
            "justMyCode": false,
            "args": [
                "--model", "openai_compatible",
                "--model_args", "model_version=gpt-4o",
                "--tasks",  "test_extract_gdt",
                "--batch_size", "1",
                "--log_samples",
                "--log_samples_suffix", "new_run",
                "--output_path", "./logs/",
                "--verbosity=DEBUG",
                "--use_cache", "../lmms-eval/cache",
                "--cache_requests", "true",
            ],
            "python": "${command:python.interpreterPath}", // works since selected
             "env": {
                "CUDA_VISIBLE_DEVICES": "7",
            }
        },
