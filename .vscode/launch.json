                "--tasks", "test_extract_gdt",
                //"--tasks", "extract_gdt_3_50_answer_multiturn",
                "--batch_size", "8",
                "--log_samples",
                "--log_samples_suffix", "llava_next",
                "--output_path", "./logs/",
                "--device", "cuda"
            ],
            "python": "${command:python.interpreterPath}",
            "env": {
                "CUDA_VISIBLE_DEVICES": "7"
            }
        },
        {
